# ASTROAM Frontend Configuration (PUBLIC ONLY)
# Never place private API keys, secrets, or seeds in this file.

# Operation mode: "api" (connect to real backend) | "demo" (isolated local mock)
VITE_ASTROAM_MODE=api

# Base URL of the ASTROAM backend API, INCLUDING the /api prefix
# (e.g. https://api.example.com/api). Leave it unset in local dev: the app
# then calls /api and Vite proxies it to http://localhost:8080.
# VITE_API_BASE_URL=http://localhost:8080/api

# Production (Vercel or any static host). Set these on the host, not in a file:
#   VITE_API_BASE_URL  the hosted API, including /api (e.g. https://astroam-api.example.com/api)
#   VITE_ASTROAM_MODE  api. Use demo only for an offline preview: demo simulates every payment.
# The traveler app reads the escrow address, token and chain from the API,
# so no contract address or key belongs in this file.
