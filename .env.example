# AstroAm server configuration. Copy to .env; every value has a working
# default for local demos, so `cp .env.example .env` is enough to start.

# ---------------------------------------------------------------------------
# server
# ---------------------------------------------------------------------------

PORT=8080

# Where missions, eSIM records and webhook logs are stored (JSON files).
DATA_DIR=./data

# ---------------------------------------------------------------------------
# payments — the chain the traveler pays on
# ---------------------------------------------------------------------------

# Payment rail (src/rails/). "fake" (default) simulates deposits, the payment
# channel and the vouchers in memory: no wallet, no network. "monad" uses the
# AstroAmEscrow contract on Monad testnet (contracts/): the traveler deposits
# USDC from their wallet, the app signs vouchers with a session key and the
# API closes the escrow with what was actually used.
PAYMENT_RAIL=fake

# --- PAYMENT_RAIL=monad ----------------------------------------------------
# Deploy with `npm run monad:deploy` (it prints these values).
# Current testnet deployment (v3, with claim, payee configured): 0xe89893d51180e517e2bf175398aad2e6da82c0f9
# MONAD_ESCROW_ADDRESS=0x...
# Key of the escrow's payee: receives used USDC and is the only account that
# can close an escrow. Needs testnet MON for gas (https://faucet.monad.xyz).
# Never logged.
# MONAD_PAYEE_PRIVATE_KEY=0x...
# Optional overrides (defaults: Monad testnet, Circle USDC).
# MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# MONAD_CHAIN_ID=10143
# MONAD_EXPLORER_URL=https://testnet.monadvision.com
# MONAD_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
# Only read by `npm run monad:deploy` (export them in the shell, do not keep
# the key here): the deployer key (the payee by default) and optional overrides.
# MONAD_DEPLOYER_PRIVATE_KEY=0x...
# MONAD_PAYEE_ADDRESS=0x...
# MONAD_TIMEOUT_SECONDS=2592000

# ---------------------------------------------------------------------------
# connectivity — Citrus Mobile (eSIM provisioning, usage, cutoff)
# ---------------------------------------------------------------------------

# "fake" (default) uses an in-memory provider (demos and tests, no
# credentials); "citrus" talks to the real Citrus reseller API.
CONNECTIVITY_PROVIDER=fake

# Reseller API key (rsk_…). Required when CONNECTIVITY_PROVIDER=citrus.
# Never logged.
CITRUS_API_KEY=

# Citrus reseller API base URL (not a secret).
CITRUS_BASE_URL=https://citrusmobile.com/api/v2/reseller

# Shared secret that verifies inbound Citrus webhooks (x-signature). Without
# it the server runs without the /citrus/webhooks route.
CITRUS_WEBHOOK_SECRET=

# Timeout (ms) per Citrus HTTP request.
CITRUS_REQUEST_TIMEOUT_MS=10000

# Early warning threshold for Citrus reseller wallet balance in USD (C3/C1).
# If the account balance drops below this amount, operational alerts are raised.
CITRUS_RESELLER_LOW_BALANCE_USD=20

# Provider cost to provision a new eSIM in USD cents (C3/C1, default 175 = $1.75).
# Used to verify balance sufficiency before starting a new mission.
CITRUS_ESIM_PROVISION_CENTS=175

# ---------------------------------------------------------------------------
# pricing
# ---------------------------------------------------------------------------

# Price per decimal MB in raw units (1 raw = 1e-7 USDC). Leave empty to use
# each destination's own rate, the one the app shows (e.g. Brazil 0.0025
# USDC/MB = 25000). Set it only to force one price for every destination.
PRICE_PER_MB_RAW=

# ---------------------------------------------------------------------------
# product API — the frontend's /api
# ---------------------------------------------------------------------------

# Live mode: true requires a live payment rail and Citrus, and an access
# token on every route that changes data.
ASTROAM_LIVE_ENABLED=false

# Token required as `Authorization: Bearer <token>` on mutable routes in
# live mode.
# ASTROAM_DEMO_ACCESS_TOKEN=

# Allowed CORS origin(s) for the frontend.
# Can be a single URL, '*' (demo only), or comma-separated origins.
# For mobile testing on the same Wi-Fi, add your local LAN IP:
# FRONTEND_ORIGIN=http://localhost:5173,http://192.168.1.50:5173
# Or if using a tunnel (ngrok / cloudflared):
# FRONTEND_ORIGIN=http://localhost:5173,https://your-tunnel.ngrok-free.app
FRONTEND_ORIGIN=http://localhost:5173

# Lets the app inject test traffic (POST /api/missions/:id/demo-traffic).
ENABLE_DEMO_TRAFFIC=true

# ---------------------------------------------------------------------------
# automatic fund flow (B1-B6)
# ---------------------------------------------------------------------------

# Size of one eSIM funding tranche, USD cents (default 250 = $2.50).
FUNDING_TRANCHE_CENTS=250

# Minimum gap worth a Citrus funding request, USD cents (default 50 = $0.50).
FUNDING_MIN_CENTS=50

# Uncollected voucher amount in USDC that triggers a claim on Monad (default 2 = 2 USDC).
CLAIM_MIN_USDC=2

# Safety margin before refund timeout to close automatically, seconds (default 86400 = 24h).
ESCROW_CLOSE_MARGIN_SECONDS=86400

# Close trip after this many seconds without new usage (0 turns it off).
ESCROW_IDLE_CLOSE_SECONDS=0

# Grace period after trip end date before auto-closing, seconds (default 86400 = 24h).
ESCROW_TRIP_END_GRACE_SECONDS=86400

